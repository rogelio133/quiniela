@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="bg-ball-clip" aria-hidden="true">
        <img src="/images/trionda_clean.png" class="bg-ball" alt="" />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center gap-3">
            <div class="top-row-zone d-flex justify-content-start">
                <AuthorizeView>
                    <Authorized>
                        <span class="text-white small fw-semibold text-truncate">@(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)</span>
                    </Authorized>
                </AuthorizeView>
            </div>
            <div class="d-flex justify-content-center">
                <ThemeToggle @rendermode="InteractiveServer" />
            </div>
            <div class="top-row-zone d-flex justify-content-end">
                <AuthorizeView>
                    <Authorized>
                        <form method="post" action="/api/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                        </form>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="text-white small">Iniciar sesión</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <AuthorizeView>
            <Authorized>
                <NotificationConsent @rendermode="InteractiveServer" />
            </Authorized>
        </AuthorizeView>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
