@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <img src="/images/trionda_clean.png" class="bg-ball" alt="" aria-hidden="true" />

    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end gap-3">
            <ThemeToggle @rendermode="InteractiveServer" />
            <AuthorizeView>
                <Authorized>
                    <span class="text-white small fw-semibold">@(context.User.FindFirst("DisplayName")?.Value ?? context.User.Identity?.Name)</span>
                    <form method="post" action="/api/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-outline-light">Salir</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" class="text-white small">Iniciar sesión</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>

        <AuthorizeView>
            <Authorized>
                <NotificationConsent @rendermode="InteractiveServer" />
            </Authorized>
        </AuthorizeView>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
