@page "/pools/{poolId:int}/predictions"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims

@inject PredictionService PredictionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Pronósticos — @(pool?.Name ?? "Sala")</PageTitle>

@if (isLoading)
{
    <p class="text-muted">Cargando...</p>
}
else if (pool is null || !isMember)
{
    <div class="alert alert-warning">
        Sala no encontrada o no tienes acceso.
        <a href="/pools" class="alert-link ms-2">Volver a Mis Salas</a>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/pools">Mis Salas</a></li>
            <li class="breadcrumb-item"><a href="/pools/@PoolId">@pool.Name</a></li>
            <li class="breadcrumb-item active">Próximos partidos</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Próximos partidos</h2>
        <a href="/pools/@PoolId/my-predictions" class="btn btn-outline-secondary btn-sm">
            Mis pronósticos
        </a>
    </div>

    @if (!grouped.Any())
    {
        <p class="text-muted mt-4">No hay partidos próximos disponibles.</p>
    }
    else
    {
        <div class="accordion" id="accordion-predictions">
            @foreach (var day in grouped)
            {
                var isOpen = openDays.Contains(day.Key);
                <div class="accordion-item" @key="day.Key">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(isOpen ? "" : "collapsed")"
                                type="button"
                                @onclick="() => ToggleDay(day.Key)">
                            @FormatDayHeader(day.Key)
                        </button>
                    </h2>
                    <div class="accordion-collapse collapse @(isOpen ? "show" : "")">
                        <div class="accordion-body p-2">
                            @foreach (var item in day)
                            {
                                <MatchCard Match="item.Match"
                                           ExistingPrediction="item.Prediction"
                                           PoolId="PoolId"
                                           UserId="currentUserId"
                                           ClientTz="clientTz"
                                           ReadOnly="false" />
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int PoolId { get; set; }

    private Pool? pool;
    private bool isMember;
    private bool isLoading = true;
    private int currentUserId;
    private static readonly TimeZoneInfo clientTz = TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City");

    private List<IGrouping<DateOnly, PredictionService.MatchWithPrediction>> grouped = [];
    private HashSet<DateOnly> openDays = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        var (p, member) = await PredictionService.GetPoolContextAsync(PoolId, currentUserId);
        pool = p;
        isMember = member;

        if (pool is not null && isMember)
            await LoadMatchesAsync();

        isLoading = false;
    }

    private async Task LoadMatchesAsync()
    {
        var items = await PredictionService.GetUpcomingMatchesAsync(PoolId, currentUserId);
        grouped = items
            .GroupBy(mp => DateOnly.FromDateTime(
                TimeZoneInfo.ConvertTimeFromUtc(mp.Match.KickoffUtc, clientTz)))
            .OrderBy(g => g.Key)
            .ToList();

        openDays.Clear();
        if (grouped.Count > 0)
            openDays.Add(grouped[0].Key);
    }

    private void ToggleDay(DateOnly date)
    {
        if (!openDays.Remove(date))
            openDays.Add(date);
    }

    private string FormatDayHeader(DateOnly date)
    {
        var dt = date.ToDateTime(TimeOnly.MinValue);
        return dt.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("es-MX"));
    }
}
