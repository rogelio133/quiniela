@page "/pools/{poolId:int}/my-predictions"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims

@inject PredictionService PredictionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Mis pronósticos — @(pool?.Name ?? "Sala")</PageTitle>

@if (isLoading)
{
    <SkeletonLoader ShowCard="true" />
    <SkeletonLoader ShowCard="true" />
}
else if (pool is null || !isMember)
{
    <div class="alert alert-warning">
        Sala no encontrada o no tienes acceso.
        <a href="/pools" class="alert-link ms-2">Volver a Mis Salas</a>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/pools">Mis Salas</a></li>
            <li class="breadcrumb-item"><a href="/pools/@PoolId">@pool.Name</a></li>
            <li class="breadcrumb-item active">Mis pronósticos</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Mis pronósticos</h2>
        <a href="/pools/@PoolId/predictions" class="btn btn-primary btn-sm">
            ⚽ Pronosticar
        </a>
    </div>

    @if (totalPredictions == 0)
    {
        <div class="alert alert-info mt-3">
            Aún no tienes pronósticos guardados en esta sala.
            <a href="/pools/@PoolId/predictions" class="alert-link ms-1">¡Empieza a pronosticar!</a>
        </div>
    }

    <ul class="nav nav-tabs nav-fill mb-3" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == Tab.Pending ? "active" : "")"
                    @onclick='() => activeTab = Tab.Pending'
                    type="button" role="tab">
                Pendientes
                @if (groupedPending.Count > 0)
                {
                    <span class="badge bg-primary ms-1 rounded-pill">
                        @groupedPending.Sum(g => g.Count())
                    </span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link @(activeTab == Tab.Finalized ? "active" : "")"
                    @onclick='() => activeTab = Tab.Finalized'
                    type="button" role="tab">
                Finalizados
                @if (groupedFinalized.Count > 0)
                {
                    <span class="badge bg-secondary ms-1 rounded-pill">
                        @groupedFinalized.Sum(g => g.Count())
                    </span>
                }
            </button>
        </li>
    </ul>

    @if (activeTab == Tab.Pending)
    {
        @if (!groupedPending.Any())
        {
            <p class="text-muted mt-4">No hay partidos pendientes.</p>
        }
        else
        {
            <div class="accordion" id="accordion-pending">
                @foreach (var day in groupedPending)
                {
                    var isOpen = openPendingDays.Contains(day.Key);
                    <div class="accordion-item" @key="day.Key">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(isOpen ? "" : "collapsed")"
                                    type="button"
                                    @onclick="() => TogglePendingDay(day.Key)">
                                @FormatDayHeader(day.Key)
                            </button>
                        </h2>
                        <div class="accordion-collapse collapse @(isOpen ? "show" : "")">
                            <div class="accordion-body p-2">
                                @foreach (var item in day)
                                {
                                    <MatchCard Match="item.Match"
                                               ExistingPrediction="item.Prediction"
                                               PoolId="PoolId"
                                               UserId="currentUserId"
                                               ClientTz="clientTz"
                                               ReadOnly="true"
                                               OnFlagTapped="OpenTeamSheet" />
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (activeTab == Tab.Finalized)
    {
        @if (!groupedFinalized.Any())
        {
            <p class="text-muted mt-4">No hay partidos finalizados aún.</p>
        }
        else
        {
            @if (!_hintSeen)
            {
                <p class="text-muted small mb-2" style="font-size:0.72rem;">
                    💡 Toca la bandera de un equipo para ver su historial
                </p>
            }
            <div class="accordion" id="accordion-finalized">
                @foreach (var day in groupedFinalized)
                {
                    var isOpen = openFinalizedDays.Contains(day.Key);
                    <div class="accordion-item" @key="day.Key">
                        <h2 class="accordion-header">
                            <button class="accordion-button @(isOpen ? "" : "collapsed")"
                                    type="button"
                                    @onclick="() => ToggleFinalizedDay(day.Key)">
                                @FormatDayHeader(day.Key)
                            </button>
                        </h2>
                        <div class="accordion-collapse collapse @(isOpen ? "show" : "")">
                            <div class="accordion-body p-2">
                                @foreach (var item in day)
                                {
                                    <MatchCard Match="item.Match"
                                               ExistingPrediction="item.Prediction"
                                               PoolId="PoolId"
                                               UserId="currentUserId"
                                               ClientTz="clientTz"
                                               ReadOnly="true"
                                               OnFlagTapped="OpenTeamSheet" />
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }

    <TeamSheet TeamId="_selectedTeamId"
               UserId="currentUserId"
               PoolId="PoolId"
               IsOpen="_sheetOpen"
               OnClose="CloseTeamSheet" />
}

@code {
    private enum Tab { Pending, Finalized }

    [Parameter] public int PoolId { get; set; }

    private Pool? pool;
    private bool isMember;
    private bool isLoading = true;
    private int currentUserId;
    private Tab activeTab = Tab.Pending;
    private static readonly TimeZoneInfo clientTz = TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City");
    private int totalPredictions;

    private List<IGrouping<DateOnly, PredictionService.MatchWithPrediction>> groupedPending = [];
    private List<IGrouping<DateOnly, PredictionService.MatchWithPrediction>> groupedFinalized = [];
    private HashSet<DateOnly> openPendingDays = [];
    private HashSet<DateOnly> openFinalizedDays = [];

    private int _selectedTeamId;
    private bool _sheetOpen;
    private bool _hintSeen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        var (p, member) = await PredictionService.GetPoolContextAsync(PoolId, currentUserId);
        pool = p;
        isMember = member;

        if (pool is not null && isMember)
            await LoadMatchesAsync();

        isLoading = false;
    }

    private async Task LoadMatchesAsync()
    {
        var items = await PredictionService.GetAllMatchesAsync(PoolId, currentUserId);
        totalPredictions = items.Count(mp => mp.Prediction is not null);

        groupedPending = items
            .Where(mp => mp.Match.Status == MatchStatus.Programado)
            .GroupBy(mp => DateOnly.FromDateTime(
                TimeZoneInfo.ConvertTimeFromUtc(mp.Match.KickoffUtc, clientTz)))
            .OrderBy(g => g.Key)
            .ToList();

        groupedFinalized = items
            .Where(mp => mp.Match.Status == MatchStatus.Finalizado)
            .GroupBy(mp => DateOnly.FromDateTime(
                TimeZoneInfo.ConvertTimeFromUtc(mp.Match.KickoffUtc, clientTz)))
            .OrderByDescending(g => g.Key)
            .ToList();

        openPendingDays.Clear();
        if (groupedPending.Count > 0)
            openPendingDays.Add(groupedPending[0].Key);

        openFinalizedDays.Clear();
        if (groupedFinalized.Count > 0)
            openFinalizedDays.Add(groupedFinalized[0].Key);
    }

    private void TogglePendingDay(DateOnly date)
    {
        if (!openPendingDays.Remove(date))
            openPendingDays.Add(date);
    }

    private void ToggleFinalizedDay(DateOnly date)
    {
        if (!openFinalizedDays.Remove(date))
            openFinalizedDays.Add(date);
    }

    private void OpenTeamSheet(int teamId)
    {
        _selectedTeamId = teamId;
        _sheetOpen = true;
        _hintSeen = true;
    }

    private void CloseTeamSheet()
    {
        _sheetOpen = false;
    }

    private string FormatDayHeader(DateOnly date)
    {
        var dt = date.ToDateTime(TimeOnly.MinValue);
        return dt.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("es-MX"));
    }
}
