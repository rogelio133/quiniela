@page "/pools/{poolId:int}/standings"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims

@inject PoolService PoolService
@inject StandingsService StandingsService
@inject ChampionService ChampionService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Tabla de posiciones— @(pool?.Name ?? "Sala")</PageTitle>

@if (isLoading)
{
    <SkeletonLoader ShowAvatar="true" Lines="3" />
    <SkeletonLoader ShowAvatar="true" Lines="3" />
    <SkeletonLoader ShowAvatar="true" Lines="3" />
}
else if (pool is null || !isMember)
{
    <div class="alert alert-warning">
        Sala no encontrada o no tienes acceso.
        <a href="/pools" class="alert-link ms-2">Volver a Mis Salas</a>
    </div>
}
else
{
    @* ── Breadcrumb ─────────────────────────────────────────── *@
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/pools">Mis Salas</a></li>
            <li class="breadcrumb-item"><a href="/pools/@PoolId">@pool.Name</a></li>
            <li class="breadcrumb-item active">Tabla de posiciones</li>
        </ol>
    </nav>

    @* ── Header ─────────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0 fw-bold">🏆 Tabla de posiciones</h2>
            <small class="text-muted">@pool.Name</small>
        </div>
        <div class="d-flex gap-2 flex-wrap justify-content-end">
            <a href="/pools/@PoolId/standings/history" class="btn btn-outline-secondary btn-sm">
                📈 Ver evolución
            </a>
            @if (standings.Count >= 2)
            {
                <button class="btn btn-outline-secondary btn-sm" @onclick="OpenComparePicker">
                    🆚 Comparar
                </button>
            }
            <button class="btn btn-outline-secondary btn-sm"
                    @onclick="RefreshAsync"
                    disabled="@isRefreshing">
                @if (isRefreshing)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else { <span>🔄</span> }
                Actualizar
            </button>
        </div>
    </div>

    @* ── Context strip ───────────────────────────────────────── *@
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <span class="badge rounded-pill bg-secondary fs-6 fw-normal px-3 py-2">
            👥 @pool.Members.Count @(pool.Members.Count == 1 ? "jugador" : "jugadores")
        </span>
        <span class="badge rounded-pill @(finalizedCount > 0 ? "bg-success" : "bg-secondary") fs-6 fw-normal px-3 py-2">
            ⚽ @finalizedCount @(finalizedCount == 1 ? "partido finalizado" : "partidos finalizados")
        </span>
    </div>

    @if (finalizedCount == 0)
    {
        <div class="alert alert-info d-flex align-items-center gap-2 mb-3" role="alert">
            <span style="font-size:1.1rem;">ℹ️</span>
            <span class="small">Los puntos aparecerán cuando el admin capture el primer resultado.</span>
        </div>
    }

    @if (standings.Count == 0)
    {
        <p class="text-muted text-center py-4">No hay jugadores en esta sala.</p>
    }
    else
    {
        var positions = StandingsService.ComputePositions(standings);
        var maxPoints = standings[0].TotalPoints;

        @* ── Podium (top 3) ─────────────────────────────────── *@
        @for (int i = 0; i < Math.Min(3, standings.Count); i++)
        {
            var entry  = standings[i];
            var pos    = positions[i];
            var isMe   = entry.UserId == currentUserId;
            var medal  = MedalFor(pos)!;
            var delay  = $"anim-d{i + 1}";

            <div class="podium-card podium-@pos @delay anim-fade-in-up mb-2 @(isMe ? "podium-clickable" : "")"
                 @key="entry.UserId"
                 @onclick="() => GoToStatsIfMe(entry.UserId)">
                <div class="d-flex align-items-center gap-3">

                    <span class="podium-medal">@medal</span>

                    @if (!string.IsNullOrEmpty(entry.ProfilePicturePath))
                    {
                        <img src="@entry.ProfilePicturePath"
                             class="rounded-circle flex-shrink-0"
                             style="width:44px;height:44px;object-fit:cover;"
                             alt="@entry.DisplayName" />
                    }
                    else
                    {
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border flex-shrink-0"
                             style="width:44px;height:44px;font-size:1.4rem;">⚽</div>
                    }

                    <div class="flex-grow-1 overflow-hidden">
                        <div class="d-flex align-items-center gap-1">
                            <span class="fw-bold text-truncate" style="font-size:0.95rem;">@entry.DisplayName</span>
                            @if (isMe) { <span class="badge bg-primary flex-shrink-0" style="font-size:.55rem;padding:2px 5px;">TÚ</span> }
                            @{ var (deltaClass, deltaText) = DeltaFor(entry.UserId, pos); }
                            <small class="@deltaClass fw-semibold flex-shrink-0" style="font-size:.68rem;">@deltaText</small>
                        </div>
                        <small class="text-muted" style="font-size:.68rem;">@entry.CorrectPredictions ✓ / @entry.TotalPredictions pronósticos</small>
                        @if (championPicks.TryGetValue(entry.UserId, out var champTeamTop))
                        {
                            <small class="d-block text-muted" style="font-size:.65rem;">
                                👑 <span class="fi fi-@champTeamTop.FlagCode.ToLower()" style="width:14px !important;height:11px !important;border-radius:2px;"></span> @(champTeamTop.ShortCode ?? champTeamTop.Name)
                            </small>
                        }
                    </div>

                    <div class="text-end flex-shrink-0">
                        <div class="podium-pts">@entry.TotalPoints</div>
                        <small class="text-muted" style="font-size:.62rem;">pts</small>
                    </div>
                </div>
            </div>
        }

        @* ── Rest of standings ──────────────────────────────── *@
        @if (standings.Count > 3)
        {
            <div class="list-group shadow-sm mt-1">
                @for (int i = 3; i < standings.Count; i++)
                {
                    var entry = standings[i];
                    var pos   = positions[i];
                    var isMe  = entry.UserId == currentUserId;
                    var pct   = PointsPct(entry.TotalPoints, maxPoints);
                    var delay = $"anim-d{Math.Min(i - 2, 6)}";

                    <div class="list-group-item list-group-item-action py-3 px-3 @delay anim-fade-in-up @(isMe ? "border-start border-3 border-primary" : "")"
                         @key="entry.UserId"
                         @onclick="() => GoToStatsIfMe(entry.UserId)">
                        <div class="d-flex align-items-center gap-2">
                            <div class="text-center flex-shrink-0" style="width:26px;">
                                <span class="text-muted fw-semibold" style="font-size:.88rem;">@pos</span>
                            </div>

                            @if (!string.IsNullOrEmpty(entry.ProfilePicturePath))
                            {
                                <img src="@entry.ProfilePicturePath"
                                     class="rounded-circle flex-shrink-0"
                                     style="width:40px;height:40px;object-fit:cover;"
                                     alt="@entry.DisplayName" />
                            }
                            else
                            {
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border flex-shrink-0"
                                     style="width:40px;height:40px;font-size:1.2rem;">⚽</div>
                            }

                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="fw-semibold text-truncate @(isMe ? "text-primary" : "")" style="font-size:.9rem;">@entry.DisplayName</span>
                                    @if (isMe) { <span class="badge bg-primary flex-shrink-0" style="font-size:.55rem;padding:2px 5px;">TÚ</span> }
                                    @{ var (deltaClass, deltaText) = DeltaFor(entry.UserId, pos); }
                                    <small class="@deltaClass fw-semibold flex-shrink-0" style="font-size:.68rem;">@deltaText</small>
                                </div>
                                @if (championPicks.TryGetValue(entry.UserId, out var champTeamRest))
                                {
                                    <small class="d-block text-muted" style="font-size:.65rem;">
                                        👑 <span class="fi fi-@champTeamRest.FlagCode.ToLower()" style="width:14px !important;height:11px !important;border-radius:2px;"></span> @(champTeamRest.ShortCode ?? champTeamRest.Name)
                                    </small>
                                }
                                <div class="progress mt-1" style="height:3px;border-radius:2px;">
                                    <div class="progress-bar bg-primary"
                                         role="progressbar"
                                         style="width:@pct%;"
                                         aria-valuenow="@entry.TotalPoints"
                                         aria-valuemin="0"
                                         aria-valuemax="@maxPoints"></div>
                                </div>
                            </div>

                            <div class="text-end flex-shrink-0">
                                <div class="fw-bold @(isMe ? "text-primary" : "")" style="font-size:1.1rem;">@entry.TotalPoints</div>
                                <small class="text-muted d-block" style="font-size:.62rem;">pts</small>
                                <small class="text-muted d-block" style="font-size:.65rem;">@entry.CorrectPredictions✓&nbsp;/&nbsp;@entry.TotalPredictions</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    }
}

@if (comparePickerOpen)
{
    <div class="cmp-sheet-overlay" @onclick="CloseComparePicker">
        <div class="cmp-sheet-panel" @onclick:stopPropagation="true">
            <div class="cmp-sheet-handle"></div>
            <div class="cmp-sheet-title">Elige dos jugadores para comparar</div>
            <div class="cmp-sheet-list">
                @foreach (var entry in standings)
                {
                    var role = pickA == entry.UserId ? 1 : (pickB == entry.UserId ? 2 : 0);
                    <div class="cmp-sheet-row @(role == 1 ? "cmp-sheet-row-a" : role == 2 ? "cmp-sheet-row-b" : "")"
                         @key="entry.UserId"
                         @onclick="() => TogglePick(entry.UserId)">
                        @if (!string.IsNullOrEmpty(entry.ProfilePicturePath))
                        {
                            <img src="@entry.ProfilePicturePath" class="cmp-sheet-avatar" alt="@entry.DisplayName" />
                        }
                        else
                        {
                            <div class="cmp-sheet-avatar cmp-sheet-avatar-fallback">⚽</div>
                        }
                        <span class="cmp-sheet-name">@entry.DisplayName</span>
                        @if (role == 1) { <span class="cmp-sheet-tag cmp-sheet-tag-a">1</span> }
                        else if (role == 2) { <span class="cmp-sheet-tag cmp-sheet-tag-b">2</span> }
                    </div>
                }
            </div>
            <button type="button" class="btn btn-primary w-100 cmp-sheet-go"
                    disabled="@(pickA is null || pickB is null)"
                    @onclick="GoToComparison">
                Comparar
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public int PoolId { get; set; }

    private Pool? pool;
    private bool isMember;
    private bool isLoading   = true;
    private bool isRefreshing;
    private int  currentUserId;
    private int  finalizedCount;
    private List<StandingsService.StandingEntry> standings = [];
    private Dictionary<int, int> previousPositions = [];
    private Dictionary<int, Team> championPicks = [];

    private bool comparePickerOpen;
    private int? pickA;
    private int? pickB;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);
        pool     = await PoolService.GetPoolWithMembersAsync(PoolId);
        isMember = pool?.Members.Any(m => m.UserId == currentUserId) == true;

        if (pool is not null && isMember)
            await LoadDataAsync();

        isLoading = false;
    }

    private async Task LoadDataAsync()
    {
        finalizedCount     = await StandingsService.GetFinalizedMatchCountAsync();
        standings          = await StandingsService.GetStandingsAsync(PoolId);
        previousPositions  = await StandingsService.GetLastSnapshotPositionsAsync(PoolId);
        championPicks      = await ChampionService.GetAllPredictionsForPoolAsync(PoolId);
    }

    private async Task RefreshAsync()
    {
        isRefreshing = true;
        await LoadDataAsync();
        isRefreshing = false;
    }

    private static List<int> ComputePositions(IReadOnlyList<StandingsService.StandingEntry> list)
    {
        var pos = new int[list.Count];
        for (int i = 0; i < list.Count; i++)
        {
            if (i == 0) { pos[i] = 1; continue; }
            bool tied = list[i].TotalPoints == list[i - 1].TotalPoints
                     && list[i].CorrectPredictions == list[i - 1].CorrectPredictions;
            pos[i] = tied ? pos[i - 1] : i + 1;
        }
        return [.. pos];
    }

    private static string? MedalFor(int pos) => pos switch { 1 => "🥇", 2 => "🥈", 3 => "🥉", _ => null };

    private void GoToStatsIfMe(int userId)
    {
        if (userId == currentUserId)
            NavigationManager.NavigateTo($"/pools/{PoolId}/my-stats");
    }

    private static int PointsPct(int pts, int max) => max > 0 ? (int)(pts * 100.0 / max) : 0;

    private void OpenComparePicker()
    {
        pickA = null;
        pickB = null;
        comparePickerOpen = true;
    }

    private void CloseComparePicker() => comparePickerOpen = false;

    private void TogglePick(int userId)
    {
        if (pickA == userId) pickA = null;
        else if (pickB == userId) pickB = null;
        else if (pickA is null) pickA = userId;
        else if (pickB is null) pickB = userId;
        else pickB = userId;
    }

    private void GoToComparison()
    {
        if (pickA is null || pickB is null) return;
        NavigationManager.NavigateTo($"/pools/{PoolId}/standings/vs?a={pickA}&b={pickB}");
    }

    private (string CssClass, string Text) DeltaFor(int userId, int currentPos)
    {
        if (!previousPositions.TryGetValue(userId, out var prevPos))
            return ("text-muted", "─");

        var delta = prevPos - currentPos; // positive = moved up
        return delta switch
        {
            > 0 => ("text-success", $"▲+{delta}"),
            < 0 => ("text-danger", $"▼{delta}"),
            _   => ("text-muted", "─"),
        };
    }
}
