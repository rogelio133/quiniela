@page "/pools/{poolId:int}/my-stats"
@attribute [Authorize]
@rendermode InteractiveServer

@using System.Security.Claims

@inject PredictionService PredictionService
@inject PlayerStatsService PlayerStatsService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Estadísticas — @(pool?.Name ?? "Sala")</PageTitle>

@if (isLoading)
{
    <SkeletonLoader ShowCard="true" Lines="4" />
}
else if (pool is null || !isMember)
{
    <div class="alert alert-warning">
        Sala no encontrada o no tienes acceso.
        <a href="/pools" class="alert-link ms-2">Volver a Mis Salas</a>
    </div>
}
else
{
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/pools">Mis Salas</a></li>
            <li class="breadcrumb-item"><a href="/pools/@PoolId">@pool.Name</a></li>
            <li class="breadcrumb-item active">Mis estadísticas</li>
        </ol>
    </nav>

    <h2 class="mb-3">📊 Mis estadísticas</h2>

    @if (stats!.TotalPredictions == 0)
    {
        <div class="alert alert-info">Aún no hay partidos finalizados.</div>
    }
    else
    {
        <div class="card mb-3 stats-headline">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="fs-3 fw-bold">@stats.TotalPoints pts</div>
                    <small class="text-muted">Posición #@stats.Position de @stats.TotalMembers</small>
                </div>
                <div class="stats-headline-emoji">🏆</div>
            </div>
        </div>

        <div class="row row-cols-2 g-2 mb-3">
            <div class="col">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Aciertos</small>
                        <span class="fw-bold">@stats.CorrectResults / @stats.TotalPredictions</span>
                        <small class="text-muted">(@Pct(stats.CorrectResults, stats.TotalPredictions)%)</small>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Aciertos grupos</small>
                        <span class="fw-bold">@stats.GroupCorrect / @stats.GroupPredictions</span>
                        <small class="text-muted">(@Pct(stats.GroupCorrect, stats.GroupPredictions)%)</small>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Aciertos KO</small>
                        <span class="fw-bold">@stats.KoCorrect / @stats.KoPredictions</span>
                        <small class="text-muted">(@Pct(stats.KoCorrect, stats.KoPredictions)%)</small>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <small class="text-muted d-block">Puntos instancia</small>
                        <span class="fw-bold">@stats.CorrectInstances aciertos</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body d-flex justify-content-around text-center py-3">
                <div>
                    <div class="fw-bold fs-5">@stats.BestStreak</div>
                    <small class="text-muted">Mejor racha</small>
                </div>
                <div>
                    <div class="fw-bold fs-5">@stats.CurrentStreak</div>
                    <small class="text-muted">Racha actual</small>
                </div>
            </div>
        </div>

        @if (stats.PointsByDay.Count > 0)
        {
            var maxDayPoints = stats.PointsByDay.Max(d => d.Points);
            <div class="card">
                <div class="card-body">
                    <small class="text-muted d-block mb-2">Puntos por jornada</small>
                    <div class="stats-bar-chart">
                        @foreach (var day in stats.PointsByDay)
                        {
                            var pct = maxDayPoints > 0 ? (day.Points * 100 / maxDayPoints) : 0;
                            <div class="stats-bar-col" title="@day.Date.ToString("dd/MM"): @day.Points pts">
                                <div class="stats-bar" style="height: @(pct)%"></div>
                                <span class="stats-bar-label">@day.Date.ToString("dd/MM")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public int PoolId { get; set; }

    private Pool? pool;
    private bool isMember;
    private bool isLoading = true;
    private int currentUserId;
    private PlayerStats? stats;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        currentUserId = int.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        var (p, member) = await PredictionService.GetPoolContextAsync(PoolId, currentUserId);
        pool = p;
        isMember = member;

        if (pool is not null && isMember)
            stats = await PlayerStatsService.GetAsync(currentUserId, PoolId);

        isLoading = false;
    }

    private static int Pct(int part, int total) => total > 0 ? (int)(part * 100.0 / total) : 0;
}
