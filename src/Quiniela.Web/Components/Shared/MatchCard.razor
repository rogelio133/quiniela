@inject PredictionService PredictionService
@inject IJSRuntime JS

<div class="match-card mb-3 @(IsLocked ? "match-locked" : "")">

    @* ── Header ──────────────────────────────────────────────── *@
    <div class="mc-header @(IsInProgress ? "mc-header-live" : "")">
        <div class="mc-header-info">
            @if (Match.Stage == MatchStage.Grupos)
            {
                <span class="mc-stage">⚽ GRUPO @Match.GroupCode</span>
            }
            else
            {
                <span class="mc-stage">⚽ @StageName(Match.Stage)</span>
            }
            @if (!string.IsNullOrWhiteSpace(Match.Venue))
            {
                <span class="mc-venue">@Match.Venue.ToUpperInvariant()</span>
            }
            @if (IsInProgress)
            {
                <span class="mc-live-badge"><span class="live-dot"></span> EN CURSO</span>
            }
        </div>
        <div class="mc-time-block">
            <span class="mc-date">@LocalDate</span>
            <span class="mc-time">@LocalTime</span>
            @if (ClosingInText is not null)
            {
                <span class="mc-closing-badge">⏱ @ClosingInText</span>
            }
        </div>
    </div>

    @* ── Selection zone ──────────────────────────────────────── *@
    <div class="mc-body">
        <div class="mc-options @(IsKnockout ? "mc-options-ko" : "")">

            @* Local *@
            <div class="mc-option @OutcomeClass('H')"
                 role="@(IsInteractive ? "button" : null)"
                 @onclick="@(() => SelectOutcome('H'))">
                <span class="fi fi-@Match.HomeTeam!.FlagCode mc-flag @(FlagsAreTappable || FlagsDblTappable ? "mc-flag-tappable" : "")"
                      @onclick:stopPropagation="FlagsAreTappable"
                      @onclick="TapHomeFlag"></span>
                <span class="mc-code">@TeamShort(Match.HomeTeam)</span>
                <span class="mc-name">@Match.HomeTeam.Name.ToUpperInvariant()</span>
                @if (selectedOutcome == 'H') { <span class="mc-check">✓</span> }
            </div>

            @* Empate (solo grupos) *@
            @if (!IsKnockout)
            {
                <div class="mc-option mc-draw-col @OutcomeClass('D')"
                     role="@(IsInteractive ? "button" : null)"
                     @onclick="@(() => SelectOutcome('D'))">
                    <span class="mc-draw-icon">🤝</span>
                    <span class="mc-draw-label">EMPATE</span>
                    @if (selectedOutcome == 'D') { <span class="mc-check">✓</span> }
                </div>
            }

            @* Visitante *@
            <div class="mc-option @OutcomeClass('A')"
                 role="@(IsInteractive ? "button" : null)"
                 @onclick="@(() => SelectOutcome('A'))">
                <span class="fi fi-@Match.AwayTeam!.FlagCode mc-flag @(FlagsAreTappable || FlagsDblTappable ? "mc-flag-tappable" : "")"
                      @onclick:stopPropagation="FlagsAreTappable"
                      @onclick="TapAwayFlag"></span>
                <span class="mc-code">@TeamShort(Match.AwayTeam)</span>
                <span class="mc-name">@Match.AwayTeam.Name.ToUpperInvariant()</span>
                @if (selectedOutcome == 'A') { <span class="mc-check">✓</span> }
            </div>
        </div>
    </div>

    @* ── Selector de instancia (solo KO) ──────────────────────── *@
    @if (IsKnockout)
    {
        <div class="mc-instance">
            <span class="mc-instance-label">¿Cómo se define?</span>
            <div class="mc-instance-opts">
                <button class="mc-inst-chip @(selectedInstance == MatchDecidedIn.Regular90 ? "mc-inst-selected" : "")"
                        @onclick="() => SelectInstance(MatchDecidedIn.Regular90)" disabled="@(!IsInteractive)">90'</button>
                <button class="mc-inst-chip @(selectedInstance == MatchDecidedIn.ExtraTime ? "mc-inst-selected" : "")"
                        @onclick="() => SelectInstance(MatchDecidedIn.ExtraTime)" disabled="@(!IsInteractive)">T. Extra</button>
                <button class="mc-inst-chip @(selectedInstance == MatchDecidedIn.Penalties ? "mc-inst-selected" : "")"
                        @onclick="() => SelectInstance(MatchDecidedIn.Penalties)" disabled="@(!IsInteractive)">Penales</button>
            </div>
        </div>
    }

    @* ── Result (shown when match is done) ───────────────────── *@
    @if (Match.Status == MatchStatus.Finalizado && Match.HomeScore.HasValue)
    {
        <div class="mc-result-footer">
            <div class="mc-result-top">
                <span class="mc-scoreboard">@Match.HomeScore – @Match.AwayScore</span>
                @if (IsKnockout && Match.DecidedIn is not null)
                {
                    <span class="mc-decided-in">@DecidedInLabel(Match.DecidedIn.Value)</span>
                }
            </div>
            @if (ExistingPrediction is not null)
            {
                <div class="mc-pts-breakdown">
                    @if (IsKnockout)
                    {
                        <span class="badge @(ExistingPrediction.PtsResult > 0 ? "bg-success" : "bg-secondary")">
                            @(ExistingPrediction.PtsResult > 0 ? $"+{ExistingPrediction.PtsResult} avance ✓" : "avance ✗")
                        </span>
                        <span class="badge @(ExistingPrediction.PtsInstance > 0 ? "bg-success" : "bg-secondary")">
                            @(ExistingPrediction.PtsInstance > 0 ? $"+{ExistingPrediction.PtsInstance} instancia ✓" : "instancia ✗")
                        </span>
                    }
                    else
                    {
                        var hit = ExistingPrediction.Points > 0;
                        <span class="badge @(hit ? "bg-success" : "bg-secondary")">
                            @(hit ? $"+{ExistingPrediction.Points} pts ✓" : "0 pts ✗")
                        </span>
                    }
                </div>
            }
            else
            {
                <span class="badge bg-secondary">Sin pronóstico</span>
            }
        </div>
        @if (OnViewPredictions.HasDelegate)
        {
            <button class="mc-view-all-btn"
                    @onclick="() => OnViewPredictions.InvokeAsync(Match.Id)">
                <span class="mc-va-icon">👥</span>
                <span class="mc-va-text">Ver pronósticos de todos</span>
                <span class="mc-va-arrow">›</span>
            </button>
        }
    }

    @* ── Save button ─────────────────────────────────────────── *@
    @if (!ReadOnly)
    {
        <div class="mc-save-footer">
            @if (saveError is not null)
            {
                <div class="alert alert-danger py-1 px-2 mb-2 small" role="alert">@saveError</div>
            }
            @if (IsLocked)
            {
                <button class="btn btn-secondary w-100" disabled>🔒 Partido iniciado</button>
            }
            else
            {
                <button class="btn @(savedOk ? "btn-success" : "btn-primary") w-100"
                        @onclick="Save"
                        disabled="@saving">
                    @if (saving)       { <span>Guardando...</span> }
                    else if (savedOk)  { <span>✓ Guardado</span> }
                    else               { <span>Guardar pronóstico</span> }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Match Match { get; set; } = null!;
    [Parameter] public Prediction? ExistingPrediction { get; set; }
    [Parameter, EditorRequired] public int PoolId { get; set; }
    [Parameter, EditorRequired] public int UserId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public TimeZoneInfo ClientTz { get; set; } = TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City");
    [Parameter] public EventCallback<int> OnFlagTapped { get; set; }
    [Parameter] public EventCallback<int> OnViewPredictions { get; set; }

    private char? selectedOutcome;
    private MatchDecidedIn? selectedInstance;
    private bool saving;
    private bool savedOk;
    private string? saveError;
    private bool _initialized;

    private bool IsLocked         => Match.KickoffUtc <= DateTime.UtcNow;
    private bool IsInteractive    => !IsLocked && !ReadOnly;
    private bool IsInProgress     => IsLocked && Match.Status == MatchStatus.Programado;
    private bool IsKnockout       => Match.Stage != MatchStage.Grupos;
    private bool FlagsAreTappable => ReadOnly && Match.Status == MatchStatus.Finalizado;
    private bool FlagsDblTappable => OnFlagTapped.HasDelegate && Match.Status == MatchStatus.Programado;

    private DateTime? _homeFlagLastTap;
    private DateTime? _awayFlagLastTap;
    private const int DoubleTapMs = 400;

    private DateTime LocalKickoff => TimeZoneInfo.ConvertTimeFromUtc(Match.KickoffUtc, ClientTz);
    private string LocalDate => LocalKickoff.ToString("MMM dd", new System.Globalization.CultureInfo("es-MX")).ToUpperInvariant();
    private string LocalTime => LocalKickoff.ToString("HH:mm");

    private string? ClosingInText
    {
        get
        {
            var diff = Match.KickoffUtc - DateTime.UtcNow;
            if (diff <= TimeSpan.Zero || diff > TimeSpan.FromHours(6)) return null;
            return diff.TotalHours >= 1
                ? $"{(int)diff.TotalHours}h {diff.Minutes:D2}m"
                : $"{(int)diff.TotalMinutes}m";
        }
    }

    protected override void OnParametersSet()
    {
        if (!_initialized)
        {
            selectedOutcome = ExistingPrediction?.PredOutcome;
            selectedInstance = ExistingPrediction?.PredInstance;
            _initialized = true;
        }
    }

    private void SelectOutcome(char outcome)
    {
        if (!IsInteractive) return;
        selectedOutcome = outcome;
        saveError = null;
        savedOk = false;
    }

    private void SelectInstance(MatchDecidedIn instance)
    {
        if (!IsInteractive) return;
        selectedInstance = instance;
        saveError = null;
        savedOk = false;
    }

    private string OutcomeClass(char outcome)
    {
        var selected = selectedOutcome == outcome;
        var disabled = !IsInteractive;
        return $"{(selected ? "mc-option-selected" : "")} {(disabled ? "mc-option-disabled" : "")}";
    }

    private async Task Save()
    {
        if (!selectedOutcome.HasValue)
        {
            saveError = "Selecciona un resultado antes de guardar.";
            return;
        }
        if (IsKnockout && !selectedInstance.HasValue)
        {
            saveError = "Selecciona la instancia antes de guardar.";
            return;
        }
        if (IsLocked)
        {
            saveError = "El partido ya inició.";
            return;
        }

        saving = true;
        saveError = null;
        var (success, error) = await PredictionService.UpsertAsync(
            UserId, PoolId, Match.Id, selectedOutcome.Value, selectedInstance);
        saving = false;

        if (success)
        {
            savedOk = true;
            try
            {
                await JS.InvokeVoidAsync("confetti", new
                {
                    particleCount = 55,
                    spread        = 55,
                    origin        = new { y = 0.85 },
                    colors        = new[] { "#1A56DB", "#059669", "#F59E0B", "#FFFFFF" }
                });
            }
            catch { /* confetti es opcional */ }
        }
        else
        {
            saveError = error;
        }
    }

    private async Task TapHomeFlag()
    {
        if (FlagsAreTappable && OnFlagTapped.HasDelegate)
        {
            await OnFlagTapped.InvokeAsync(Match.HomeTeam!.Id);
            return;
        }
        if (FlagsDblTappable)
        {
            var now = DateTime.UtcNow;
            if (_homeFlagLastTap.HasValue && (now - _homeFlagLastTap.Value).TotalMilliseconds <= DoubleTapMs)
            {
                _homeFlagLastTap = null;
                await OnFlagTapped.InvokeAsync(Match.HomeTeam!.Id);
            }
            else
            {
                _homeFlagLastTap = now;
            }
        }
    }

    private async Task TapAwayFlag()
    {
        if (FlagsAreTappable && OnFlagTapped.HasDelegate)
        {
            await OnFlagTapped.InvokeAsync(Match.AwayTeam!.Id);
            return;
        }
        if (FlagsDblTappable)
        {
            var now = DateTime.UtcNow;
            if (_awayFlagLastTap.HasValue && (now - _awayFlagLastTap.Value).TotalMilliseconds <= DoubleTapMs)
            {
                _awayFlagLastTap = null;
                await OnFlagTapped.InvokeAsync(Match.AwayTeam!.Id);
            }
            else
            {
                _awayFlagLastTap = now;
            }
        }
    }

    private static string TeamShort(Team team) =>
        !string.IsNullOrWhiteSpace(team.ShortCode)
            ? team.ShortCode
            : team.Name[..Math.Min(3, team.Name.Length)].ToUpperInvariant();

    private static string DecidedInLabel(MatchDecidedIn decidedIn) => decidedIn switch
    {
        MatchDecidedIn.Regular90 => "90'",
        MatchDecidedIn.ExtraTime => "T.Extra",
        MatchDecidedIn.Penalties => "Penales",
        _ => decidedIn.ToString()
    };

    private static string StageName(MatchStage stage) => stage switch
    {
        MatchStage.Dieciseisavos => "DIECISEISAVOS",
        MatchStage.Octavos       => "OCTAVOS",
        MatchStage.Cuartos       => "CUARTOS",
        MatchStage.Semifinal     => "SEMIFINAL",
        MatchStage.TercerLugar   => "TERCER LUGAR",
        MatchStage.Final         => "FINAL",
        _                        => stage.ToString().ToUpperInvariant()
    };
}
