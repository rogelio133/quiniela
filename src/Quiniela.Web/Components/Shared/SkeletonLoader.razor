@if (ShowCard)
{
    <div class="skeleton skeleton-card mb-3"></div>
    <div class="skeleton skeleton-card mb-3"></div>
}
else
{
    <div role="status" aria-label="Cargando...">
        @if (ShowAvatar)
        {
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="skeleton skeleton-avatar"></div>
                <div class="flex-grow-1">
                    <div class="skeleton skeleton-title" style="width:50%"></div>
                    <div class="skeleton skeleton-text" style="width:35%"></div>
                </div>
            </div>
        }
        @for (int i = 0; i < Lines; i++)
        {
            var w = (i % 3 == 0) ? "88%" : (i % 3 == 1) ? "72%" : "58%";
            <div class="skeleton skeleton-text" style="width:@w"></div>
        }
    </div>
}

@code {
    [Parameter] public int Lines { get; set; } = 4;
    [Parameter] public bool ShowAvatar { get; set; }
    [Parameter] public bool ShowCard { get; set; }
}
