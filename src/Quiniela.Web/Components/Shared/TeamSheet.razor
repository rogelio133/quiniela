@inject TeamSheetService TeamSheetService

@if (IsOpen)
{
    <div class="ts-overlay" @onclick="HandleClose">
        <div class="ts-panel" @onclick:stopPropagation="true">

            <div class="ts-handle"></div>

            @if (data is null)
            {
                <div class="d-flex justify-content-center align-items-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            }
            else
            {
                @* ── Team header ─────────────────────────────── *@
                <div class="ts-header">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fi fi-@data.Team.FlagCode.ToLower() ts-flag"></span>
                        <div>
                            <h5 class="ts-team-name">@data.Team.Name.ToUpperInvariant()</h5>
                            @if (data.Team.GroupCode.HasValue)
                            {
                                <span class="ts-group-label">GRUPO @data.Team.GroupCode</span>
                            }
                        </div>
                    </div>
                    <button class="ts-close-btn" @onclick="HandleClose" aria-label="Cerrar">×</button>
                </div>

                @* ── Dato curioso ─────────────────────────────── *@
                @if (!string.IsNullOrWhiteSpace(data.DatoCurioso))
                {
                    <section class="ts-section ts-curiosity">
                        <h6 class="ts-section-title">¿Sabías que?</h6>
                        <div class="ts-curiosity-card">
                            <span class="ts-curiosity-icon">💡</span>
                            <p class="ts-curiosity-text">@data.DatoCurioso</p>
                        </div>
                    </section>
                }

                @* ── Historial mundialista ────────────────────── *@
                @if (data.HistorialMundiales.Any())
                {
                    <section class="ts-section">
                        <h6 class="ts-section-title">Historial mundialista</h6>
                        <div class="ts-historial-list">
                            @foreach (var h in data.HistorialMundiales)
                            {
                                <div class="ts-historial-row">
                                    <span class="ts-historial-tournament">@h.Mundial</span>
                                    <span class="ts-historial-badge ts-historial-@HistorialClass(h.Posicion)">@h.Posicion</span>
                                </div>
                            }
                        </div>
                    </section>
                }

                @* ── Director técnico ─────────────────────────── *@
                @if (!string.IsNullOrWhiteSpace(data.DirectorTecnico))
                {
                    <section class="ts-section">
                        <h6 class="ts-section-title">Director Técnico</h6>
                        <div class="ts-dt-row">
                            <span class="ts-dt-icon">🧑‍💼</span>
                            <span class="ts-dt-name">@data.DirectorTecnico</span>
                        </div>
                    </section>
                }

                @* ── Group position ───────────────────────────── *@
                @if (data.GroupPosition is not null)
                {
                    <section class="ts-section">
                        <h6 class="ts-section-title">Posición en grupo</h6>
                        <div class="ts-position-row">
                            <span class="ts-rank">@data.GroupPositionRank°</span>
                            <div class="ts-stats">
                                <span>@data.GroupPosition.Won G</span>
                                <span>@data.GroupPosition.Drawn E</span>
                                <span>@data.GroupPosition.Lost P</span>
                                <span class="ts-stat-sep">·</span>
                                <span>GF @data.GroupPosition.GoalsFor</span>
                                <span>GC @data.GroupPosition.GoalsAgainst</span>
                            </div>
                            <span class="ts-pts-badge">@data.GroupPosition.Points pts</span>
                        </div>
                    </section>
                }

                @* ── Previous matches ─────────────────────────── *@
                <section class="ts-section">
                    <h6 class="ts-section-title">Partidos anteriores</h6>
                    @if (!data.PreviousMatches.Any())
                    {
                        <p class="text-muted small mb-0">Sin partidos anteriores.</p>
                    }
                    else
                    {
                        @foreach (var entry in data.PreviousMatches)
                        {
                            var m      = entry.Match;
                            var isHome = m.HomeTeamId == TeamId;
                            var ourScore   = isHome ? m.HomeScore : m.AwayScore;
                            var rivalScore = isHome ? m.AwayScore : m.HomeScore;
                            var matchIcon  = ourScore > rivalScore ? "✅"
                                           : ourScore == rivalScore ? "🤝" : "❌";
                            var pred = entry.UserPrediction;

                            <div class="ts-match-row">
                                <div class="ts-match-info">
                                    <span class="ts-result-icon">@matchIcon</span>
                                    <div class="overflow-hidden">
                                        <span class="ts-match-score">
                                            @TeamCode(m.HomeTeam) @m.HomeScore–@m.AwayScore @TeamCode(m.AwayTeam)
                                        </span>
                                        <span class="ts-match-date">
                                            @m.KickoffUtc.ToString("dd MMM", new System.Globalization.CultureInfo("es-MX")).ToUpperInvariant()
                                        </span>
                                    </div>
                                </div>
                                @if (pred is not null)
                                {
                                    var hit = pred.Points > 0;
                                    <span class="ts-pred @(hit ? "ts-pred-hit" : "ts-pred-miss")">
                                        @(hit ? $"✓ +{pred.Points} pts" : "✗ 0 pts")
                                    </span>
                                }
                                else
                                {
                                    <span class="ts-pred ts-pred-none">—</span>
                                }
                            </div>
                        }
                    }
                </section>

                @* ── Upcoming matches ─────────────────────────── *@
                <section class="ts-section">
                    <h6 class="ts-section-title">Próximos partidos</h6>
                    @if (!data.UpcomingMatches.Any())
                    {
                        <p class="text-muted small mb-0">Sin partidos próximos.</p>
                    }
                    else
                    {
                        @foreach (var m in data.UpcomingMatches)
                        {
                            var isHome = m.HomeTeamId == TeamId;
                            var rival  = isHome ? m.AwayTeam : m.HomeTeam;
                            var kt     = TimeZoneInfo.ConvertTimeFromUtc(
                                             m.KickoffUtc,
                                             TimeZoneInfo.FindSystemTimeZoneById("America/Mexico_City"));

                            <div class="ts-upcoming-row">
                                <span class="ts-upcoming-icon">⏳</span>
                                <div>
                                    <span class="ts-match-score">vs @(rival?.Name ?? "Por definir")</span>
                                    <span class="ts-match-date">
                                        @kt.ToString("dd MMM · HH:mm", new System.Globalization.CultureInfo("es-MX")).ToUpperInvariant()
                                    </span>
                                </div>
                            </div>
                        }
                    }
                </section>

                @* ── Jugadores convocados ──────────────────────── *@
                @if (data.Jugadores.Any())
                {
                    var posicionOrder = new[] { "Portero", "Defensa", "Mediocampista", "Delantero" };
                    var grupos = data.Jugadores
                        .GroupBy(j => j.Posicion)
                        .OrderBy(g => Array.IndexOf(posicionOrder, g.Key));

                    <section class="ts-section ts-section-last">
                        <h6 class="ts-section-title">Jugadores convocados</h6>
                        @foreach (var grupo in grupos)
                        {
                            <p class="ts-pos-label">@grupo.Key</p>
                            <div class="ts-players-grid">
                                @foreach (var j in grupo)
                                {
                                    <div class="ts-player-chip">@j.Nombre</div>
                                }
                            </div>
                        }
                    </section>
                }
            }

        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public int TeamId { get; set; }
    [Parameter, EditorRequired] public int UserId { get; set; }
    [Parameter, EditorRequired] public int PoolId { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private TeamSheetData? data;
    private int _loadedForTeam;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && TeamId > 0 && TeamId != _loadedForTeam)
        {
            _loadedForTeam = TeamId;
            data = null;
            data = await TeamSheetService.GetTeamSheetAsync(TeamId, UserId, PoolId);
        }
        if (!IsOpen)
        {
            data = null;
            _loadedForTeam = 0;
        }
    }

    private async Task HandleClose() => await OnClose.InvokeAsync();

    private static string TeamCode(Team? team) =>
        team is null ? "?" : team.Name;

    private static string HistorialClass(string posicion)
    {
        var p = posicion.ToLowerInvariant();
        if (p.Contains("campeón") || p.Contains("campeon") || p.Contains("ganador")) return "champion";
        if (p.Contains("subcampeón") || p.Contains("subcampeon") || (p.Contains("final") && !p.Contains("semi") && !p.Contains("cuartos") && !p.Contains("octavos"))) return "final";
        if (p.Contains("semifinal") || p.Contains("3er") || p.Contains("tercer")) return "semi";
        if (p.Contains("cuartos")) return "quarters";
        if (p.Contains("octavos") || p.Contains("segunda ronda") || p.Contains("16")) return "round16";
        if (p.Contains("grupos")) return "groups";
        return "none";
    }
}
